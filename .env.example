# ==============================================================================
# CanvasFlow Environment Configuration Template (.env.example)
#
# DO NOT commit real secrets or production credentials to source control.
# Copy this file to .env for local development or input the variables into your
# hosting provider's dashboard (e.g., Vercel for web, Railway/Render for server).
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel / apps/web)
# ------------------------------------------------------------------------------
# Realtime WebSocket URL (Socket.IO backend)
# Example Production: https://canvasflow-backend.onrender.com or https://api.yourdomain.com
# Example Local Dev:  http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# REST API Base URL
# Example Production: https://canvasflow-backend.onrender.com or https://api.yourdomain.com
# Example Local Dev:  http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Persistent Node.js Host / apps/server)
# ------------------------------------------------------------------------------
# The port on which the Express & Socket.IO server listens.
# (Most hosting platforms like Render, Railway, Fly.io, Heroku inject PORT automatically)
PORT=4000

# Environment mode: development | production | test
NODE_ENV=development

# Secret key used for signing and verifying JWT authentication tokens.
# Generate a strong key for production: openssl rand -base64 32
JWT_SECRET=canvasflow-super-secret-jwt-key-2026

# Allowed frontend origin(s) for CORS and Socket.IO handshakes.
# Supports comma-separated origins and wildcards for preview deployments:
# Example Production: https://canvasflow.vercel.app,https://*-your-team.vercel.app
# Example Local Dev:  http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Snapshot persistence frequency to PostgreSQL in milliseconds
AUTOSAVE_INTERVAL_MS=3000

# ------------------------------------------------------------------------------
# INFRASTRUCTURE DATASOURCES
# ------------------------------------------------------------------------------
# PostgreSQL Database Connection String (used by Prisma ORM)
# Managed Cloud (e.g., Supabase / Neon / AWS RDS / Render Postgres):
# postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Local Docker Dev:
DATABASE_URL=postgresql://whiteboard:whiteboard_secret@localhost:5432/whiteboard_db?schema=public

# Redis Connection URL (used for Distributed Pub/Sub & Multi-instance scaling)
# Managed Cloud (e.g., Upstash / Redis Cloud / AWS ElastiCache / Render Redis):
# rediss://default:PASSWORD@HOST:6379 (uses rediss:// with TLS)
# Local Docker Dev:
REDIS_URL=redis://localhost:6379
