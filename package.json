{
  "name": "collab-whiteboard-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:web": "npm run dev --workspace=@whiteboard/web",
    "dev:server": "npm run dev --workspace=@whiteboard/server",
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark": "tsx scripts/benchmark-engine.ts",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^5.7.3"
  }
}
